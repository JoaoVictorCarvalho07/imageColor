# PocketBase (self-hosted)
# URL pública usada pelo navegador (login da fotógrafa via Google OAuth)
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090
# URL usada pelo servidor Next.js e pelos scripts (pode ser a mesma)
POCKETBASE_URL=http://127.0.0.1:8090
# Superuser do PocketBase: todo acesso a dados passa pelo servidor com esta conta
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# E-mails (separados por vírgula) autorizados a entrar em /admin.
# Sem esta variável ninguém entra. O primeiro e-mail recebe os avisos de seleção.
ADMIN_EMAILS=

# Cloudflare R2 — buckets fixos no código: image-color (público) e image-color-private
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# URL pública do bucket image-color, sem barra final
CLOUDFLARE_R2_PUBLIC_URL=

# Google Drive (OAuth) — OAuth Client "Aplicativo da Web" no Google Cloud
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/admin/drive/callback

# Chave AES-256 (hex de 64 caracteres) que criptografa o refresh_token do Drive.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

# URL base do app (e-mails, retorno do checkout, webhook e CORS do R2).
# Produção: https://galeria.isabelpontes.com.br
APP_URL=http://localhost:3000
# Origens extras liberadas no CORS do bucket privado, separadas por vírgula (scripts/setup-r2-cors.mjs)
R2_CORS_EXTRA_ORIGINS=https://imagecolor-nu.vercel.app

# E-mail (Resend) — sem a chave os e-mails são apenas simulados no log
RESEND_API_KEY=
EMAIL_FROM=

# Estúdio
NEXT_PUBLIC_STUDIO_NAME=Isabel Pontes
# Padrão: NEXT_PUBLIC_STUDIO_NAME em maiúsculas
WATERMARK_TEXT=

# Somente desenvolvimento: "1" habilita /api/dev/e2e (exige sessão de admin). Nunca em produção.
ENABLE_DEV_E2E=
# Opcional: pasta com imagens de teste usada pelo /api/dev/e2e
E2E_IMAGE_DIR=

# Mercado Pago (Checkout Pro: Pix e cartão)
# Access token de teste em dev; de produção no deploy. Painel: Suas integrações > Credenciais.
MERCADOPAGO_ACCESS_TOKEN=
# Assinatura secreta do webhook (Suas integrações > Webhooks). URL: <APP_URL>/api/webhooks/mercadopago
MERCADOPAGO_WEBHOOK_SECRET=
