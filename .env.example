# Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role (secret) — necessário para o fluxo da cliente no servidor
SUPABASE_SERVICE_ROLE_KEY=

# Google Drive (OAuth) — OAuth Client "Aplicativo da Web" no Google Cloud
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/admin/drive/callback

# Chave AES-256 (hex de 32 bytes) p/ criptografar o refresh_token do Drive.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

# URL base para links nos e-mails
APP_URL=http://localhost:3000

# E-mail (Resend) — opcional; sem a chave, e-mails só são simulados (log)
RESEND_API_KEY=
EMAIL_FROM=

# Integrações futuras
# MERCADOPAGO_ACCESS_TOKEN=
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET=
# RESEND_API_KEY=
